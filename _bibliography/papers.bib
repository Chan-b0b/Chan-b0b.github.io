@unpublished{lee2026film,
  abbr        = {Under Review},
  title       = {How Force Enters Matters: {FiLM} Conditioning for Behavior-Cloned {VLA} Policies},
  author      = {Lee, Chanho},
  note        = {Submitted to IEEE International Conference on Robotics and Automation (ICRA) 2027},
  year        = {2026},
  month       = sep,
  abstract    = {Vision-language-action (VLA) policies increasingly receive wrist wrench and contact signals in their state, yet a behavior-cloned policy given the full wrench can still fail to bind its behavior to it. On a real-robot suction picking task with a force-sensitive payload---a hard contact-force limit, so that force must govern when the descent ends---a naively fine-tuned VLA shows the familiar failure: the wrench in its state does not come to govern its behavior, and it presses on through contact until an external safety limit intervenes. We present a conditioning pathway that changes how force is delivered, not what is delivered: a condition vector (contact, force magnitude, seal) computed from signals the policy already receives and fed to the VLA through a FiLM layer. The pathway has three properties. It is drop-in: no backbone change, no new information, no cost in imitation error, and, since it touches only the state input, it applies to any VLA that consumes a proprioceptive state. It is retrofittable: attached to an already-trained naive policy and trained further on the same demonstrations, it rewires how that policy responds to force. And it generalizes beyond the demonstrations: because force magnitude reaches the action through FiLM's affine modulation, the policy brakes harder the harder it is pressed, stopping and retreating at forces beyond the demonstrations, where imitation alone leaves the response unspecified; and because the stop is tied to force rather than to appearance, picks succeed at a stack height absent from training. We also ran it on our robot: every FiLM-policy pick stops on its own at low contact force, whereas the naive policy drives contact force past the limit in every attempt, and on-robot counterfactual probes reproduce the offline crossover.},
  selected    = {true}
}

@article{lee2024dpcsma,
  abbr        = {IEEE Access},
  title       = {Dynamic-Persistent {CSMA}: A Reinforcement Learning Approach for Multi-User Channel Access},
  author      = {Lee, Chanho and Park, Seungkeun and Cheong, Taesu},
  journal     = {IEEE Access},
  volume      = {12},
  pages       = {178705--178718},
  year        = {2024},
  month       = nov,
  doi         = {10.1109/ACCESS.2024.3506972},
  abstract    = {This paper addresses the challenge of multiple users concurrently sharing a single channel in a wireless network. We propose Dynamic-Persistent CSMA (DP-CSMA), incorporating a deep reinforcement learning model that dynamically adjusts the waiting period based on current state. The DRL model captures dynamic history using LSTM and compresses actions into skills via a Variational Autoencoder, enabling zero-shot generalization: trained on 5–10 agents, the policy achieves top throughput even in 100-agent environments without retraining.},
  bibtex_show = {true},
  selected    = {true}
}

@article{lee2025viewplanning,
  abbr        = {JARA},
  title       = {Is View Planning Always Effective for {3D} Reconstruction?},
  author      = {Lee, Chanho and Han, David},
  journal     = {Journal of Artificial Intelligence Research and Applications},
  year        = {2025},
  month       = nov,
  abstract    = {We investigate how the effectiveness of view planning varies with a reconstruction model's dependency on semantic information. We introduce PIFu-A, a pixel-aligned implicit function model with an attention-based encoder for multi-view 3D reconstruction, and compare it with Pix2Vox. Using an RL-based (PPO) next-best-view planning architecture, we show that view planning is significantly more effective for geometric models than semantic ones—up to 80% improvement—validated on ShapeNet (39,699 models, 13 categories). Research conducted at Drexel University, USA.},
  bibtex_show = {true},
  selected    = {true}
}
